{
  "name": "nabais.me",
  "version": "2023.12.1",
  "private": true,
  "description": "nabais.me website",
  "author": "Luis Nabais <luis@nabais.me>",
  "license": "MIT",
  "main": "src/pages/index.jsx",
  "engines": {
    "node": ">= 24.0.0",
    "npm": ">= 9.0.0"
  },
  "type": "module",
  "scripts": {
    "setup": "npm run astro:sync",
    "astro:sync": "ASTRO_TELEMETRY_DISABLED=1 astro sync",
    "build": "npm run build:web",
    "build:web": "ASTRO_TELEMETRY_DISABLED=1 NODE_ENV=production astro build",
    "clean": "rimraf .astro coverage dist node_modules/.vite src/**/*.generated.*",
    "debug": "npm run debug:serve",
    "debug:serve": "NODE_ENV=development astro dev",
    "debug:test": "vitest dev",
    "serve": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "lint": "run-s lint:types lint:js lint:styles",
    "lint:fix": "run-s lint:fix:js lint:fix:styles",
    "lint:types": "ASTRO_TELEMETRY_DISABLED=1 astro check && tsc --noEmit",
    "lint:fix:js": "eslint --fix .",
    "lint:js": "eslint .",
    "lint:styles": "stylelint src/**/*.sass src/**/*.scss src/**/*.css",
    "lint:fix:styles": "stylelint src/**/*.sass src/**/*.scss src/**/*.css --fix",
    "start": "npm run debug",
    "test": "npm run test:js",
    "test:js": "vitest --run --passWithNoTests",
    "test:js:update": "vitest --run -u --passWithNoTests",
    "test:ci": "CI=true vitest --coverage --passWithNoTests"
  },
  "browserslist": [
    "> 0.2%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "dependencies": {
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/react": "^4.4.2",
    "@fontsource/play": "^5.2.8",
    "@fontsource/roboto-condensed": "^5.2.8",
    "@icons-pack/react-simple-icons": "^13.11.2",
    "@sentry/browser": "^10.39.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "clsx": "^2.1.1",
    "feather-icons": "^4.29.2",
    "iso-url": "^1.2.1",
    "keen-slider": "^6.8.6",
    "lodash-es": "^4.17.23",
    "normalize.css": "^8.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-feather": "^2.0.10",
    "rooks": "^9.5.0",
    "yet-another-react-lightbox": "^3.29.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/ts-plugin": "^1.10.6",
    "@eslint/js": "^9.39.2",
    "@sentry/cli": "^3.2.1",
    "@stylistic/eslint-plugin": "^5.7.1",
    "@stylistic/stylelint-plugin": "^5.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/lodash-es": "^4.17.12",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-istanbul": "^4.0.18",
    "astro": "^5.17.3",
    "astro-eslint-parser": "^1.3.0",
    "eslint": "^9.39.3",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "sass": "^1.97.3",
    "stylelint": "^17.3.0",
    "stylelint-config-recommended-scss": "^17.0.0",
    "stylelint-order": "^7.0.1",
    "stylelint-scss": "^7.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vitest": "^4.0.18"
  }
}
