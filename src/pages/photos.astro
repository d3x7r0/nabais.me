---
import type { PhotosImageEntry } from '../js/components/page/Photos'
import type { CollectionEntry } from 'astro:content'

import { getCollection } from 'astro:content'

import PhotosPage from '../js/components/page/Photos'
import { TITLES } from '../js/config'
import PageLayout from '../layouts/default.astro'

const photos: CollectionEntry<'photos'>[] = await getCollection('photos')

const BASE_PHOTOS_URL = import.meta.env.PUBLIC_BASE_PHOTOS_URL ?? Astro.site?.toString()
const BASE_PHOTOS_PATH = '/static/photos'

const images: PhotosImageEntry[] = photos.map((entry) => {
  const href = new URL(`${BASE_PHOTOS_PATH}/${entry.id}`, BASE_PHOTOS_URL).toString()

  return {
    href,
    src: href,
    ...entry.data,
  }
})
---

<PageLayout title={TITLES.PHOTOS}>
  {BASE_PHOTOS_URL && (
    <link
      href={BASE_PHOTOS_URL}
      rel="preconnect"
      slot="head"
    />
  )}

  <PhotosPage client:only="react" images={images} />
</PageLayout>
